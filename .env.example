# Browser-visible Supabase project URL and anonymous/publishable key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Canonical deployed origin used for invitation callbacks; no trailing slash.
NEXT_PUBLIC_APP_URL=

# Server-only credentials. Never use NEXT_PUBLIC_ for these values.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVIDENCE_BUCKET=attendance-evidence
CRON_SECRET=

# Optional explicit demo provisioning. Keep disabled in production.
ENABLE_DEMO_SEED=false
SEED_SECRET=
TEST_ACCOUNT_PASSWORD=
# Local development only; still requires a pre-existing demo membership.
ALLOW_DEMO_AUTH=false

# Optional external SMTP for local Supabase Auth (defaults to local Inbucket/Mailpit test mailbox when false).
# Never commit real SMTP credentials to the repository.
SUPABASE_AUTH_SMTP_ENABLED=false
SUPABASE_AUTH_SMTP_HOST=
SUPABASE_AUTH_SMTP_PORT=587
SUPABASE_AUTH_SMTP_USER=
SUPABASE_AUTH_SMTP_PASS=
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=
SUPABASE_AUTH_SMTP_SENDER_NAME=LoopyCafe

