{
  "name": "loopicafe-management-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node tooling/run-local.mjs dev",
    "build": "node tooling/run-local.mjs build",
    "build:production": "node tooling/build-production.mjs",
    "start": "node tooling/run-local.mjs preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "types:generate": "wrangler types worker-configuration.d.ts --config tooling/workers-types.jsonc --include-env false",
    "typecheck": "npm run types:generate && tsc --noEmit --incremental false",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:preflight": "node tooling/schema-preflight.mjs",
    "local:doctor": "node tooling/local.mjs doctor",
    "local:auth:start": "node tooling/local.mjs auth:start",
    "local:auth:stop": "node tooling/local.mjs auth:stop",
    "local:auth:configure": "node tooling/local.mjs auth:configure",
    "local:migrate": "node tooling/local.mjs migrate",
    "local:provision": "node tooling/local.mjs provision",
    "local:storage:verify": "node --experimental-strip-types tooling/verify-local-storage.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^12.43.0",
    "jpeg-js": "^0.4.4",
    "leaflet": "^1.9.4",
    "lucide-react": "0.468.0",
    "next": "^16.4.0",
    "page-mascot": "^0.1.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "miniflare": "4.20260515.0",
    "react-server-dom-webpack": "19.2.6",
    "supabase": "2.117.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
