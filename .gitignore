# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
__pycache__/
*.py[cod]

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-dev-*.log
.codex-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example
/worker-configuration.d.ts

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
**/.wrangler/
/wrangler.production.jsonc
/outputs/
/work/

# Isolated local auth/runtime credentials and generated test output
.dev.vars*
TEST_ACCOUNTS.md
tooling/local-auth/supabase/.temp/
tooling/local-auth/supabase/.branches/
playwright-report/
test-results/
