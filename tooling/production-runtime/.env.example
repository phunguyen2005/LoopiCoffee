# Public build settings. Put these in Cloudflare Builds environment variables,
# or copy this file to .env.production here. Root .env.local is never loaded.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://loopicafe-production.YOUR_SUBDOMAIN.workers.dev
# Runtime service-role key and CRON_SECRET belong in Worker secrets, not here.
